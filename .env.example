# 복사해서 .env 로 저장한 뒤 필요한 값만 바꾼다.

# 리포트 파일 소유자 (홈서버에서 `id -u`, `id -g` 로 확인)
PUID=1000
PGID=1000

# 매일 실행 시각 HH:MM (config.json 의 timezone 기준)
RUN_AT=08:23

# 선택: GitHub 토큰. 권한을 하나도 주지 않은 토큰이면 충분하다 (공개 검색 조회 전용).
GITHUB_TOKEN=

# 선택: 한글 요약용 LLM (OpenAI 호환 Chat Completions API, 기본은 NVIDIA NIM https://build.nvidia.com).
# 키가 있으면 tracker/notes_ko.json 에 요약이 없는 레포를 'AI 요약' 으로 채운다. 비워 두면 쓰지 않는다.
# 보내는 것은 공개 레포의 README 앞부분과 스킬 이름·설명뿐이다.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=z-ai/glm-5.3-flash
